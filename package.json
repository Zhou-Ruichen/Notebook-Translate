{
  "name": "ipynb-translator",
  "displayName": "Jupyter Notebook Markdown 英译汉",
  "description": "将Jupyter Notebook中的Markdown单元格从英文翻译为中文",
  "version": "0.4.0",
  "publisher": "RuichenZhou",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zhou-Ruichen/Notebook-Translate.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ipynbTranslator.translateMarkdownEnToZh",
    "onCommand:ipynbTranslator.testConnection",
    "onCommand:ipynbTranslator.manageProfiles",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ipynbTranslator.manageProfiles",
        "title": "IPynb Translator: Manage Profiles",
        "icon": "$(gear)"
      },
      {
        "command": "ipynbTranslator.newProfile",
        "title": "IPynb Translator: New Profile",
        "icon": "$(add)"
      },
      {
        "command": "ipynbTranslator.translateMarkdownEnToZh",
        "title": "IPynb Translator: Translate Notebook"
      },
      {
        "command": "ipynbTranslator.testConnection",
        "title": "IPynb Translator: Test Connection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ipynbTranslator",
          "title": "Notebook Translator",
          "icon": "$(translations)"
        }
      ]
    },
    "views": {
      "ipynbTranslator": [
        {
          "id": "ipynbTranslator.profilesView",
          "name": "Profiles"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ipynbTranslator.newProfile",
          "when": "view == ipynbTranslator.profilesView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Jupyter Notebook Markdown 翻译器",
      "properties": {
        "ipynbTranslator.activeProfile": {
          "type": "string",
          "default": "",
          "description": "Current active profile. Please use 'Select Profile' command to switch.",
          "scope": "window",
          "markdownDescription": "Current active profile name. **Do not edit manually.** Use `IPynb Translator: Select Profile` command to switch."
        },
        "ipynbTranslator.profiles": {
          "type": "array",
          "default": [
            {
              "name": "Local Ollama (Default)",
              "provider": "ollama",
              "endpoint": "http://localhost:11434",
              "model": "llama3"
            }
          ],
          "description": "翻译服务配置列表",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "配置名称（唯一标识）"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "ollama",
                  "baidu"
                ],
                "description": "服务提供商类型"
              },
              "baseUrl": {
                "type": "string",
                "description": "API 端点"
              },
              "model": {
                "type": "string",
                "description": "模型名称"
              },
              "appId": {
                "type": "string",
                "description": "百度翻译 APP ID"
              },
              "customPrompt": {
                "type": "string",
                "description": "自定义 System Prompt (可选)",
                "markdownDescription": "Custom System Prompt to override the default translation instructions."
              }
            },
            "required": [
              "name",
              "provider"
            ]
          }
        },
        "ipynbTranslator.translationMode": {
          "type": "string",
          "enum": [
            "replace",
            "bilingual"
          ],
          "default": "bilingual",
          "description": "翻译模式：replace（替换原文）或 bilingual（双语对照）"
        },
        "ipynbTranslator.enableStatsLogging": {
          "type": "boolean",
          "default": false,
          "description": "是否记录翻译统计到 .vscode/translator-stats.jsonl",
          "markdownDescription": "Append per-translation stats (model, profile, char count, latency) to `.vscode/translator-stats.jsonl`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "package": "npm run compile -- --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
